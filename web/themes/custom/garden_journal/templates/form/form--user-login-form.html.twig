{#
/**
 * @file
 * Garden Journal's override for the user login form element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see \Drupal\Core\Form\FormPreprocess::preprocessForm()
 *
 * @ingroup themeable
 */
#}

<form{{attributes}}>
  <div class="form__header">
    <div class="form__header-icon"><img src="/{{ base_path ~ directory }}/logo.svg" alt="{{ 'Garden Journal logo'|t }}" fetchpriority="high"/></div>
    <h2>{{ 'Welcome back'|t }}</h2>
    <p>{{ 'Log in to your Garden Journal account'|t }}</p>
  </div>
  <div class="form__body">
    {{children }}
  </div>
  <div class="form__footer">
    <a href="/user/password" target="_blank">{{ 'Forgot your password?'|t }}</a>
    <a href="/user/register" target="_blank">{{ "Don't have an account? Create one"|t }}</a>
  </div>
</form>
